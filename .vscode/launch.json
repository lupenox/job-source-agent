{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Walk pipeline (mock LinkedIn, no API spend)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--linkedin-url",
        "https://www.linkedin.com/company/stripe",
        "--mock",
        "--no-llm"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "stopOnEntry": false
    },
    {
      "name": "Walk success path (no browser, no network)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_agent.py::test_find_job_source_success_path",
        "-s",
        "--no-header"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
